# Backend origin. The dev backend listens on :8080.
VITE_API_BASE=http://localhost:8080

# Set to "1" to bypass HTTP/WS and use in-memory seed data instead.
# Lets you work on the UI without the Actix backend running.
VITE_USE_MOCKS=0

# Solana RPC endpoint used by the wallet adapter (devnet is fine for local dev).
VITE_SOLANA_RPC=https://api.devnet.solana.com

# Display-only — shown in the sign-in card eyebrow ("Sign in · devnet").
# Doesn't switch chains on its own; pair it with the matching VITE_SOLANA_RPC.
VITE_SOLANA_CLUSTER=devnet
