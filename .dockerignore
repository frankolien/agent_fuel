# Build cache / artifacts we never want in the Docker context.
target/
**/node_modules/
**/dist/
.git/
.github/

# Frontend / SDK — backend image doesn't ship them.
clients/
# …except clients/runtime: a workspace member, so cargo must parse its
# manifest even though `-p agent_fuel_backend` won't actually compile it.
!clients/runtime/

# Editor / OS noise.
.vscode/
.idea/
**/.DS_Store

# Sensitive: never bake secrets into an image.
.env
.env.*
!.env.example

# Logs + scratch.
*.log
run.log
