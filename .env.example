# Copy to `.env` at the repo root and fill in. Backend reads ../.env from
# `backend/` and from the repo root via dotenvy. See docs/dependencies.md
# for the full inventory.

BIND_ADDR=127.0.0.1:8080
RUST_LOG=info,agent_fuel_backend=debug

# Postgres — required. Local default points at the `agent_fuel_pg` docker
# container on host port 5434 (5432/5433 are usually taken).
DATABASE_URL=postgres://agent_fuel:agent_fuel@127.0.0.1:5434/agent_fuel
DB_MAX_CONNECTIONS=10

# SIWS / JWT — required for /auth/verify and any /api/* route.
# Generate JWT_SECRET with: openssl rand -hex 32
JWT_SECRET=replace-me
SIWS_DOMAIN=agent-fuel.local
SIWS_CHAIN_ID=solana:devnet

# Optional locally — uncomment + fill when you need the feature.
# REDIS_URL=redis://127.0.0.1:6379
# HELIUS_WEBHOOK_SECRET=
# SOLANA_RPC_URL=https://api.devnet.solana.com
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# Dev USDC airdrop — for dev/staging deploys ONLY. When the mint and ONE of
# the two authority vars are set AND SOLANA_RPC_URL is set, the backend
# mounts POST /api/dev/airdrop, which mints dev USDC to any wallet on
# demand (1000 default, 10000 cap, rate-limited 1 req / 30s per IP). The
# mobile fund sheet calls this automatically when a deposit fails with
# "insufficient funds". NEVER set either authority var in production —
# without one of them the route is not registered.
#
# Security model: the mint authority key is devnet-only and rotatable
# (mint a fresh dev USDC + redeploy if leaked). Do not reuse this pattern
# for a mainnet mint authority — host the key in an HSM / KMS instead.
#
# AGENT_FUEL_USDC_MINT=EMm5UveNWJaTfbMcJ8g2w7i2riydKKyZWhauEj8DzRTq
#
# Local dev (file path):
# AGENT_FUEL_USDC_MINT_AUTHORITY_PATH=/Users/you/.config/solana/id.json
#
# Cloud deploys (Railway / Render / Fly — no filesystem access):
#   Generate the b64 form:
#     base64 -i ~/.config/solana/id.json | tr -d '\n'
#   Then paste the output into Railway's env var dashboard.
# AGENT_FUEL_USDC_MINT_AUTHORITY_B64=

# FCM push notifications — optional. When ONE of the two vars below is set,
# the backend exchanges the service account for an OAuth2 access token and
# fans every alert out to all device_tokens registered for the alert's
# owner. Leaving both unset falls back to LogNotifier (alerts visible only
# in backend logs). Get the JSON from Firebase Console → Project settings →
# Service accounts → Generate new private key.
#
# Local dev (file path):
# FCM_SERVICE_ACCOUNT_PATH=/Users/you/secrets/agent-fuel-fcm-sa.json
#
# Cloud deploys (Railway / Render / Fly):
#   base64 -i agent-fuel-fcm-sa.json | tr -d '\n'
# FCM_SERVICE_ACCOUNT_B64=
