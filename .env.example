# Agent Fuel backend — copy to `.env` and fill in. See docs/dependencies.md §10
# for the full inventory and which provider supplies each value.

# --- Process ---
BIND_ADDR=127.0.0.1:8080
RUST_LOG=info

# --- Postgres (Neon / local Docker) ---
DATABASE_URL=postgres://agent_fuel:agent_fuel@127.0.0.1:5432/agent_fuel
DB_MAX_CONNECTIONS=10

# --- Redis (Upstash / local) — wired in Slice 3.5 ---
# REDIS_URL=redis://127.0.0.1:6379

# --- Solana / Helius — wired in Slice 3.2 ---
# SOLANA_RPC_URL=http://localhost:8899
# HELIUS_API_KEY=
# HELIUS_WEBHOOK_SECRET=

# --- Program IDs (filled after devnet deploy) ---
# REPUTATION_PROGRAM_ID=
# CREDIT_VAULT_PROGRAM_ID=
# USDC_MINT=

# --- Auth — wired in Slice 3.6 ---
# JWT_SECRET=

# --- FCM — wired in Slice 3.10 ---
# FCM_SERVICE_ACCOUNT_JSON=

# --- CORS — wired in Slice 4.W.10-prep ---
# Comma-separated browser origins the API will accept. Defaults to the local
# Vite dev server; add your preview/prod URLs when deploying.
# CORS_ALLOWED_ORIGINS=http://localhost:5173
