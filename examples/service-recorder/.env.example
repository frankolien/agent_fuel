# Service authority keypair — the same one you used to register the service
# in the console. Base58 string OR JSON array; the loader handles both.
SERVICE_KEYPAIR=

# Solana RPC. Use the same cluster as the agent that pays this service.
SOLANA_RPC_URL=https://api.devnet.solana.com

# Agent Fuel backend (REST + WS). Defaults to the public devnet deployment.
AGENT_FUEL_API_BASE=https://api.agentfuel.online
