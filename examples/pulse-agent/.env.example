# Solana RPC endpoint. Use a paid Helius/QuickNode URL — public endpoints
# get rate-limited within minutes of a real agent loop.
SOLANA_RPC_URL=https://api.devnet.solana.com

# Agent identity keypair. Generate with `solana-keygen new --no-bip39-passphrase
# --outfile keypairs/agent.json` and paste the JSON array here (one line).
# This is the identity the agent SIGNS with for spend instructions; it owns
# nothing of value and can be re-generated. The actual money sits in the
# vault, gated by the owner wallet that funded it.
AGENT_KEYPAIR=[1,2,3,…]

# Owner wallet that funded the vault. Only used for read-only verification
# at startup; the agent never signs as this wallet.
OWNER_PUBKEY=

# Vault PDA the agent draws from. Print this from the console after creating
# the vault for this owner + agent pair.
VAULT_PUBKEY=

# Service pubkey the agent will pay (must be whitelisted on the vault's policy,
# or you need to allow_post_pay=true). Find it on /console/services.
SERVICE_PUBKEY=

# Agent Fuel backend (REST + WS). Defaults to the public devnet deployment.
AGENT_FUEL_API_BASE=https://api.agentfuel.online
